# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-audit
dist-smoke
dist-smoke-auth
dist-ssr
*.local

# Environment — never commit your API key!
.env
.env.local
.env.*.local

# Android release-signing secrets
android/keystore.properties
*.keystore
*.jks

# Superpowers brainstorm sessions
.superpowers/

# Agent tooling — LOCAL-ONLY state, never track.
# The agent config this repo *does* track is listed in AGENTS.md under
# "Agent & tooling config"; everything here is per-machine.
# These rules previously lived only in .git/info/exclude or a global ignore
# file, i.e. on one machine — which is exactly how a second checkout ends up
# committing them by accident.
.claude/settings.local.json
.claude/worktrees/
.cursor/settings.json

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*

# Playwright test snapshots and screenshots (generated during verification runs)
.playwright-mcp/
check-*.png
audit-*.png

# Vitest coverage output
coverage/

# Supabase local-stack scratch (generated by the CLI)
supabase/.temp/
supabase/.branches/

# Lexicon raw-download cache
.cache/
.bench-baseline.json
smoke-auth-failure-*.png
dist-profile-audit/
# npm run screenshots:capture output (raw captures, store exports, build cache)
store-screenshots/
