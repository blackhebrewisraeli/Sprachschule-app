# Server-side secret — read by the Vercel functions (api/), never by the
# browser bundle. Get a key at https://console.anthropic.com
# Cloud values live in Vercel project env settings (all three environments);
# `npm run dev:full` (vercel dev) injects the Development values automatically,
# so a local .env is only a fallback.
# IMPORTANT: never commit your real .env file to git.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Second AI provider (Phase 5 stub — not live). Anthropic is the only production
# adapter. To plug in OpenAI later: add catalog rows with provider: 'openai',
# implement api/_lib/openai.js, register it in api/_lib/forward.js ADAPTERS, and
# set this server-side key. Never prefix it VITE_ — Vite would inline it into
# the public bundle.
# OPENAI_API_KEY=

# Supabase data lane (B1) — server-side only; the browser gets nothing.
#
# LOCAL DEVELOPMENT POINTS AT THE LOCAL STACK, NEVER AT A CLOUD PROJECT.
# Run `supabase start` (Docker) and use the values below verbatim — they are
# Supabase's published local defaults, identical on every machine, and are not
# secrets. `npm run test:rls` already targets this stack.
#
# Never put a cloud URL or a real service-role key here. service_role bypasses
# row-level security completely, so a production value would give local
# development unrestricted read AND write access to real learner data — the
# exact boundary the wiki's Security & Role Architecture page forbids:
# https://github.com/blackhebrewisraeli/Sprachschule-app/wiki/Security-and-Role-Architecture
# Production and Preview read their own values from Vercel; there is
# deliberately no Development-scope entry for them.
#
# When unset, the AI lane falls back to per-instance in-memory rate limiting.
SUPABASE_URL=http://127.0.0.1:54321
# Placeholder, not the real local value: GitHub secret scanning flags the
# new-format secret-key prefix on sight, and an alert nobody can action is an
# alert everyone learns to ignore. Get the actual local key — which IS fixed
# and published, and only ever authenticates against 127.0.0.1 — by running
# `supabase status` (or `supabase status -o env`) after `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# Optional origin allow-list — set in Vercel Production only (comma-separated).
# ALLOWED_ORIGINS=https://www.sprachschule-app.com,https://deutsch-app-dusky.vercel.app
# The native app's origins (capacitor://localhost, https://localhost) are
# allowed in code — api/_lib/origin.js — and need no entry here.

# Absolute origin for /api calls. Leave UNSET for the web, which calls /api
# same-origin; `npm run build:mobile` sets it to production, because a
# Capacitor webview has no /api of its own. Setting it here would also point
# every test's fetch at that host.
# VITE_API_BASE_URL=https://www.sprachschule-app.com

# Supabase auth + data lane (B2) — PUBLIC by design (RLS is the guard).
# Unlike SUPABASE_SERVICE_ROLE_KEY (server-only), these ship in the client
# bundle. When unset, the app runs guest-only (no sign-in UI) — which is a
# perfectly good way to work on UI that does not need an account.
# Local defaults again: point at the Docker stack, not at a cloud project.
# `npm run build:mobile` overrides both with the cloud project, the same way
# it pins VITE_API_BASE_URL: the native bundle is baked at build time, and a
# 127.0.0.1 baked into it is a Docker stack no phone (and no simulator
# without that stack running) can reach — sign-in then fails inside the app.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Client feature flags — read as `import.meta.env.VITE_X === 'true'`, so an
# absent var means OFF. List them explicitly (even as false) so local dev
# matches deployed behaviour instead of silently diverging: without them you
# never exercise sync or leagues locally. Both are `true` in Vercel Production.
VITE_LEAGUES_ENABLED=false
VITE_SYNC_ENABLED=false
# "Continue with Google" on the auth surfaces. This flag alone is not enough:
# it also needs the Google provider enabled in Supabase and an OAuth client in
# Google Cloud — see docs/AUTH_GOOGLE_OAUTH_RUNBOOK.md. Vite inlines env at
# build time, so flipping it in a dashboard needs a redeploy to take effect.
VITE_GOOGLE_AUTH_ENABLED=false
# "Continue with GitHub" — same shape as Google, its own flag, independent of
# it. Needs the GitHub provider enabled in Supabase and a GitHub OAuth App —
# see docs/AUTH_GITHUB_OAUTH_RUNBOOK.md. Also build-time: redeploy after a flip.
VITE_GITHUB_AUTH_ENABLED=false
# "Continue with Apple" (Sign in with Apple, via Supabase's OAuth web flow) —
# its own flag. Needs the Apple provider enabled in Supabase, an Apple Services
# ID and Sign-in key, and the account-deletion token revocation — see
# docs/AUTH_APPLE_OAUTH_RUNBOOK.md. `build:mobile` pins it false until then.
VITE_APPLE_AUTH_ENABLED=false
# Push-notification switch in Settings — NATIVE BUILDS ONLY, and only on a
# machine with android/app/google-services.json: without Firebase config,
# Android's register() crashes the app. The web never shows the switch, so
# leave this off in Vercel. Setup: docs/MOBILE_PUSH_SETUP.md.
VITE_PUSH_ENABLED=false
# Saved tutor conversations (opt-in, signed-in): shows the Settings switch and
# lets Chat ask the server to keep turns. Build-time: redeploy after a flip.
# Also needs the SERVER switch AI_HISTORY_MODE=on (Vercel Production; leave it
# unset = off) and the legal copy live first. Design:
# docs/superpowers/specs/2026-10-02-ai-tutor-conversation-history-design.md
VITE_AI_HISTORY_ENABLED=false

# Push SENDER (server-only). Vercel Production only, both Sensitive — never
# Preview (it must not ring real devices), never Development, never VITE_.
# Setup, schedule and smoke test: docs/MOBILE_PUSH_SETUP.md §6.
# PUSH_CRON_SECRET: >= 32 random chars; the SAME value lives in Supabase Vault
#   as push_cron_secret. Deliberately not CRON_SECRET (league settle).
# Sign in with Apple, account deletion only: the server revokes the learner's
# Apple token before deleting. Production, Sensitive, never VITE_-prefixed. See
# docs/AUTH_APPLE_OAUTH_RUNBOOK.md step 4.
# APPLE_SERVICES_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT: the whole JSON key of a service account holding
#   ONLY the "Firebase Cloud Messaging API Admin" role.
# PUSH_CRON_SECRET=
# FIREBASE_SERVICE_ACCOUNT=

# Closed beta. WHO MAY CREATE AN ACCOUNT is decided by Supabase Auth's
# before-user-created hook against private.beta_signup_allowlist — a database
# table, not an env var (docs/AUTH_BETA_ALLOWLIST_RUNBOOK.md).
#
# SIGNUP_EMAIL_ALLOWLIST is the optional SERVER gate for accounts that existed
# before the hook: unset/empty = off. Comma-separated, exact match after trim +
# lowercase, verified emails only (api/_lib/auth-middleware.js). Never give it
# a VITE_ prefix and never add a VITE_ copy: anything VITE_ is published in
# the client bundle, which is how the tester list leaked before.
# SIGNUP_EMAIL_ALLOWLIST=owner@example.com,friend@example.com

# Sentry client error monitoring — PUBLIC by design (a DSN only permits SENDING
# events, never reading them). Optional: when unset the app reports nothing and
# behaves exactly as today. Set it in Vercel Preview + Production only (not
# Development) to turn reporting on. Get a DSN from a free Sentry project
# (Settings → Projects → Client keys (DSN)).
# This variable takes the DSN URL and NOTHING else. A Sentry user/API token
# (`sntrys_…`, or the read token some tooling keeps for querying issues) is a
# different credential with a different job: pasted here it would not report a
# single event, and Vite would inline it into the public bundle. The only token
# this project uses at build time is SENTRY_AUTH_TOKEN, below.
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Optional label shown in Sentry (defaults to the Vite build mode):
# VITE_SENTRY_ENVIRONMENT=production
#
# The Sentry `release` needs NO configuration — vite.config.js stamps it at
# build time from Vercel's VERCEL_GIT_COMMIT_SHA, falling back to local git.
# Do NOT set VITE_SENTRY_RELEASE in the Vercel dashboard: it overrides the
# automatic value, and being static it would pin every future deploy to
# whatever commit was current when it was typed. It exists only as an escape
# hatch for builds with no git and no Vercel (a tarball, a vendored checkout).
# VITE_SENTRY_RELEASE=<commit-sha>
#
# --- Source-map upload (build-time secret, NOT a VITE_ var) ---
# SENTRY_AUTH_TOKEN turns on source-map upload so Sentry shows readable stack
# traces instead of minified ones. Set it in the Vercel dashboard on Preview +
# Production; never in this file, and never with a VITE_ prefix — Vite inlines
# VITE_* into the public bundle, which would publish a write-scoped credential.
# When it is absent the build skips upload entirely and emits no .map files.
# Needs scopes: project:releases (and org:read). Region is EU — the plugin
# defaults to https://sentry.io, which is a different tenant, so SENTRY_URL is
# pinned to https://de.sentry.io in vite.config.js.
# SENTRY_AUTH_TOKEN=<write-scoped token, set in Vercel only>
