{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/v1/league/settle.js": {
      "maxDuration": 300
    },
    "api/v1/push/streak-reminder.js": {
      "maxDuration": 300
    },
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/api/v1/league/settle", "schedule": "0 0 * * 1" }],
  "rewrites": [
    { "source": "/api/v1/progress/events", "destination": "/api/v1/progress" },
    { "source": "/api/v1/progress/daily", "destination": "/api/v1/progress" },
    { "source": "/api/v1/account/profile", "destination": "/api/v1/account" },
    { "source": "/api/v1/account/export", "destination": "/api/v1/account" },
    { "source": "/api/v1/account/delete", "destination": "/api/v1/account" },
    { "source": "/api/v1/ai/chat", "destination": "/api/v1/ai?op=chat" },
    { "source": "/api/v1/ai/deck", "destination": "/api/v1/ai?op=deck" },
    { "source": "/api/v1/ai/grade", "destination": "/api/v1/ai?op=grade" },
    { "source": "/api/chat", "destination": "/api/v1/ai?op=chat" },
    { "source": "/api/v1/admin/me", "destination": "/api/v1/admin?op=me" },
    { "source": "/api/v1/admin/feedback", "destination": "/api/v1/admin?op=feedback" },
    { "source": "/api/v1/admin/users", "destination": "/api/v1/admin?op=users" },
    { "source": "/api/v1/admin/block", "destination": "/api/v1/admin?op=block" },

    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/delete-account", "destination": "/index.html" }
  ]
}
